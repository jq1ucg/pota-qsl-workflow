+def data_root() -> Path:
+    """Return the writable root for config/logdata/var.
+
+    PSRTTY_HOME overrides everything. Otherwise the installation folder is used
+    when writable (original behaviour); on Linux a read-only install (e.g. under
+    /opt) falls back to $XDG_DATA_HOME/psrtty (~/.local/share/psrtty).
+    """
+    override = os.environ.get("PSRTTY_HOME")
+    if override:
+        return Path(override).expanduser().resolve()
+    root = app_root()
+    if sys.platform == "win32" or os.access(root, os.W_OK):
+        return root
+    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
+    return Path(base) / "psrtty"
