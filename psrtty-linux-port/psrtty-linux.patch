+def runtime_version(lib=None):
+    """Version string of the dynamically linked libhamlib, e.g. '5.0.0~git' (None if unknown)."""
+    try:
+        if lib is None:
+            lib, directory = load_library()
+            if directory:
+                directory.close()
+        lib.rig_version.restype = ctypes.c_char_p
+        text = (lib.rig_version() or b'').decode('ascii', 'replace')
+    except Exception:
+        return None
+    match = re.search(r'\d+\.\d+\.\d+\S*', text)
+    return match.group(0)[:30] if match else None
+
+
+def model_supported(lib, model_id):
+    """False when this libhamlib has no backend for model_id.
+
+    System libhamlib (e.g. distro 4.5/4.6) can predate a model; rig_init() then
+    aborts the whole process ("Hash collision!!! Fatal error!!"), so probe first.
+    """
+    try:
+        lib.rig_load_all_backends.restype = None
+        lib.rig_get_caps.restype = ctypes.c_void_p
+        lib.rig_get_caps.argtypes = [ctypes.c_int]
+        lib.rig_load_all_backends()
+        return bool(lib.rig_get_caps(model_id))
+    except AttributeError:
+        return True
