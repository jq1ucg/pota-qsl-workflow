+class IcomHamlibController(HamlibController):
+    """ICOM transceiver behind a Hamlib rigctld (TCP).
+
+    The native CI-V controller talks raw frames to a serial port and cannot be pointed at
+    a socket, so over rigctld the same operations go through the Hamlib API instead
+    (NET rigctl backend). Model-specific CI-V extras (FIL1-3 selection, the per-model
+    SWR/PWR calibration tables) have no Hamlib equivalent and report "unknown".
+    """
+    FREQ_RANGE=(100_000,15_000_000_000)
+    FUNCS={'NB':b'NB','NR':b'NR','AN':b'ANF','MN':b'MN'}
+    MODE_TOKENS={'LSB':'LSB','USB':'USB','LSB-D':'PKTLSB','USB-D':'PKTUSB'}
+
+    def __init__(self, model, endpoint):
+        from .config import RIG_MODELS
+        if not endpoint or model not in RIG_MODELS:raise ValueError(tr('ui.0e1b2eddb0064736'))
+        CIVController.__init__(self,0,model=model)
+        self.endpoint=endpoint
+        self.handle=None;self.lib=None;self.dll_directory=None
+
+    def _external_ptt(self):
+        from .radio_support import ICOM_EXTERNAL_PTT
+        return self.model in ICOM_EXTERNAL_PTT
+
+    def operating_modes(self):
+        return ('LSB-D','USB-D','LSB','USB')
+
+    def _mode_token(self,mode):
+        return self.MODE_TOKENS.get(mode)
+
+    def read_transmitting(self):
+        if self._external_ptt():  # these radios key through the external line, not CAT
+            return bool(getattr(self,'external_transmitting',False)) if self._control_ready() else None
+        return HamlibController.read_transmitting(self)
+
+    def set_ptt(self,on):
+        if self._external_ptt():return False
+        return HamlibController.set_ptt(self,on)
+
+    def read_filter(self):return None  # FIL1-3 are a CI-V concept; Hamlib exposes passband width only
+
+    def set_filter(self,*_):return False
+
+    def read_feature(self,name):
+        flag_name=self.FUNCS.get(name)
+        with self._lock:
+            if not flag_name or not self._control_ready():return None
+            try:
+                flag=self.lib.rig_parse_func(flag_name)
+                value=ctypes.c_int()
+                if not flag or self.lib.rig_get_func(self.handle,VFO,flag,ctypes.byref(value))!=0:return None
+                return bool(value.value)
+            except (AttributeError,OSError):return None
+
+    def set_feature(self,name,on):
+        with self._lock:
+            if self.read_feature(name) is None or self.read_transmitting() is not False:return False
+            try:
+                flag=self.lib.rig_parse_func(self.FUNCS[name])
+                return self.lib.rig_set_func(self.handle,VFO,flag,int(bool(on)))==0 and self.read_feature(name) is bool(on)
+            except (AttributeError,OSError):return False
+
+    def read_tuner(self):
+        with self._lock:
+            if not self._control_ready():return None
+            try:
+                flag=self.lib.rig_parse_func(b'TUNER')
+                value=ctypes.c_int()
+                if not flag or self.lib.rig_get_func(self.handle,VFO,flag,ctypes.byref(value))!=0:return None
+                return 1 if value.value else 0
+            except (AttributeError,OSError):return None
+
+    def start_tuner(self):
+        with self._lock:
+            if self.read_tuner() not in (0,1) or self.read_transmitting() is not False:return False
+            return self.lib.rig_vfo_op(self.handle,VFO,RIG_OP_TUNE)==0
+
+    def stop_tuner(self):
+        with self._lock:
+            if not self._control_ready() and not (self.handle and self.status.connected):return
+            try:
+                flag=self.lib.rig_parse_func(b'TUNER')
+                if flag:self.lib.rig_set_func(self.handle,VFO,flag,0)
+            except (AttributeError,OSError):pass
+
+    def read_alc(self):
+        # Hamlib reports ALC as 0..1; scale to the CI-V 0..255 range the gauge expects.
+        value=self._read_meter_level(b'ALC')
+        return None if value is None else value*255
