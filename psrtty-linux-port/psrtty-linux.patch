+"""rigctld (TCP) link for Hamlib models: validation, settings dialog and a fake rigctld."""
+import os
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+import copy
+import shutil
+import socket
+import subprocess
+import time
+import unittest
+from unittest.mock import Mock
+
+from PySide6.QtWidgets import QApplication
+
+from psrtty.alc_display import signature
+from psrtty.config import DEFAULT_CONFIG, DEFAULT_MACROS
+from psrtty.hamlib_radio import HamlibController, IcomHamlibController, rigctld_endpoint
+from psrtty.radio import create_controller, validate_radio
+from psrtty.ui.settings_dialog import SettingsDialog
+from tests.dialog_guard import DialogGuard
+
+BASE = dict(model='FT-991 / FT-991A', ptt='CAT', com_port='AUTO', link='rigctld',
+            rigctld_host='127.0.0.1', rigctld_port=4532)
+
+
+class EndpointTests(unittest.TestCase):
+    def test_serial_link_has_no_endpoint(self):
+        self.assertIsNone(rigctld_endpoint(dict(BASE, link='serial')))
+        self.assertIsNone(rigctld_endpoint({}))
+
+    def test_endpoint(self):
+        self.assertEqual(rigctld_endpoint(BASE), ('127.0.0.1', 4532))
+        self.assertEqual(rigctld_endpoint(dict(BASE, rigctld_host=' rig.local ', rigctld_port='4540')), ('rig.local', 4540))
+
+    def test_invalid_values_rejected(self):
+        for bad in (dict(BASE, rigctld_host=''), dict(BASE, rigctld_host='a b'), dict(BASE, rigctld_port=0),
+                    dict(BASE, rigctld_port=65536), dict(BASE, rigctld_port='x')):
+            with self.assertRaises(ValueError):
+                validate_radio(bad)
+
+    def test_rigctld_does_not_need_com_port_or_speed(self):
+        validate_radio(BASE)  # com_port AUTO and no cat_baud is fine over TCP
+        with self.assertRaises(ValueError):
+            validate_radio(dict(BASE, link='serial'))  # serial still requires them
+
+    def test_factory_passes_endpoint(self):
+        self.assertEqual(create_controller(BASE).endpoint, ('127.0.0.1', 4532))
+        self.assertIsNone(create_controller(dict(BASE, link='serial', com_port='/dev/ttyUSB0', cat_baud='38400')).endpoint)
+
+    def test_unreachable_server_reports_clearly_without_loading_hamlib(self):
+        controller = HamlibController('FT-991 / FT-991A', ('127.0.0.1', 1))  # nothing listens on port 1
+        status = controller.connect()
+        self.assertFalse(status.connected)
+        self.assertIn('127.0.0.1:1', status.message)
+
+    def test_signature_changes_only_for_rigctld(self):
+        serial = dict(BASE, link='serial')
+        self.assertEqual(signature(serial, 'x'), signature({k: v for k, v in serial.items() if k != 'link'}, 'x'))
+        self.assertNotEqual(signature(BASE, 'x'), signature(dict(BASE, rigctld_port=4533), 'x'))
+
+
+class IcomFactoryTests(unittest.TestCase):
+    ICOM = dict(model='IC-7300', ptt='CI-V', link='rigctld', rigctld_host='127.0.0.1', rigctld_port=4532)
+
+    def test_factory_builds_hamlib_backed_icom(self):
+        controller = create_controller(self.ICOM)  # no civ_address needed over rigctld
+        self.assertIsInstance(controller, IcomHamlibController)
+        self.assertEqual(controller.endpoint, ('127.0.0.1', 4532))
+        self.assertEqual(controller.operating_modes(), ('LSB-D', 'USB-D', 'LSB', 'USB'))
+
+    def test_serial_icom_still_uses_native_civ(self):
+        from psrtty.civ import CIVController
+        controller = create_controller(dict(model='IC-7300', ptt='CI-V', civ_address='94'))
+        self.assertIs(type(controller), CIVController)
+
+    def test_rts_dtr_ptt_rejected_over_rigctld(self):
+        for line in ('RTS', 'DTR'):
+            with self.assertRaises(ValueError):
+                validate_radio(dict(self.ICOM, ptt=line))
+
+    def test_external_ptt_models_need_external(self):
+        with self.assertRaises(ValueError):
+            validate_radio(dict(self.ICOM, model='IC-706', ptt='CI-V'))
+        validate_radio(dict(self.ICOM, model='IC-706', ptt='外部接続'))
+
+    def test_icom_only_controller_rejects_unknown_model(self):
+        with self.assertRaises(ValueError):
+            IcomHamlibController('NOT-A-RADIO', ('h', 1))
+
+    def test_capabilities_without_a_connection_are_unknown(self):
+        c = IcomHamlibController('IC-7300', ('127.0.0.1', 1))
+        self.assertIsNone(c.read_filter()); self.assertFalse(c.set_filter(1, {}))
+        self.assertIsNone(c.read_feature('NB')); self.assertIsNone(c.read_tuner()); self.assertFalse(c.start_tuner())
+        self.assertFalse(c.set_ptt(True)); self.assertIsNone(c.read_alc())
+
+
+@unittest.skipUnless(shutil.which('rigctld') or os.environ.get('RIGCTLD'), 'rigctld not installed')
+class LiveRigctldTests(unittest.TestCase):
+    """Run against a real rigctld with Hamlib's dummy rig (model 1)."""
+    @classmethod
+    def setUpClass(cls):
+        with socket.socket() as probe:
+            probe.bind(('127.0.0.1', 0)); cls.port = probe.getsockname()[1]
+        cls.proc = subprocess.Popen([os.environ.get('RIGCTLD') or shutil.which('rigctld'), '-m', '1', '-t', str(cls.port)],
+                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        for _ in range(50):
+            try:
+                socket.create_connection(('127.0.0.1', cls.port), timeout=.2).close(); break
+            except OSError:
+                time.sleep(.1)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.proc.terminate(); cls.proc.wait(5)
+
+    def connect(self, **extra):
+        values = dict(model='IC-7300', ptt='CI-V', link='rigctld', rigctld_host='127.0.0.1', rigctld_port=self.port, **extra)
+        controller = create_controller(values)
+        status = controller.connect()
+        if not status.connected and 'libhamlib' in status.message:
+            self.skipTest(status.message)
+        self.addCleanup(controller.disconnect)
+        return controller, status
+
+    def test_icom_controls(self):
+        c, status = self.connect()
+        self.assertTrue(status.connected, status.message)
+        self.assertTrue(c.set_frequency(144_200_000)); self.assertEqual(c.read_frequency(), 144_200_000)
+        for mode in ('LSB', 'USB-D', 'LSB-D', 'USB'):
+            self.assertTrue(c.set_operating_mode(mode), mode); self.assertEqual(c.read_operating_mode(), mode)
+        self.assertTrue(c.set_ptt(True)); self.assertTrue(c.read_transmitting())
+        self.assertTrue(c.set_ptt(False)); self.assertFalse(c.read_transmitting())
+
+    def test_yaesu_still_works(self):
+        values = dict(model='FT-991 / FT-991A', ptt='CAT', link='rigctld', rigctld_host='127.0.0.1', rigctld_port=self.port)
+        c = create_controller(values); status = c.connect()
+        if not status.connected and 'libhamlib' in status.message: self.skipTest(status.message)
+        self.addCleanup(c.disconnect); self.assertTrue(status.connected, status.message)
+        self.assertTrue(c.set_frequency(14_080_000))
+
+
+class SettingsDialogTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.guard = DialogGuard(); self.guard.start(); self.addCleanup(self.guard.stop)
+        self.store = Mock(data=copy.deepcopy(DEFAULT_CONFIG), macros=copy.deepcopy(DEFAULT_MACROS))
+
+    def dialog(self, model):
+        dlg = SettingsDialog(self.store)
+        dlg._select_data(dlg.rig, model); dlg.show()
+        return dlg
+
+    def test_link_row_for_every_selected_model(self):
+        dlg = SettingsDialog(self.store); dlg.show()
+        self.assertFalse(dlg.form_radio.isRowVisible(dlg.link))  # no model selected
+        for model in ('IC-705', 'FT-991 / FT-991A'):
+            dlg._select_data(dlg.rig, model)
+            self.assertTrue(dlg.form_radio.isRowVisible(dlg.link), model)
+            self.assertTrue(dlg.form_radio.isRowVisible(dlg.com), model)
+            self.assertFalse(dlg.form_radio.isRowVisible(dlg.rc_host), model)
+
+    def test_icom_rigctld_hides_serial_only_fields_and_ptt(self):
+        dlg = self.dialog('IC-7300')
+        self.assertEqual([dlg.ptt.itemData(i) or dlg.ptt.itemText(i) for i in range(dlg.ptt.count())], ['CI-V', 'RTS', 'DTR', '外部接続'])
+        dlg._select_data(dlg.link, 'rigctld')
+        self.assertTrue(dlg.civ_addr.isHidden()); self.assertTrue(dlg.baud.isHidden())
+        self.assertTrue(dlg.form_radio.isRowVisible(dlg.rc_host))
+        self.assertEqual([dlg.ptt.itemData(i) or dlg.ptt.itemText(i) for i in range(dlg.ptt.count())], ['CI-V', '外部接続'])
+        values = dlg._radio_values()
+        self.assertEqual((values['model'], values['link'], values['rigctld_port']), ('IC-7300', 'rigctld', 4532))
+        validate_radio(values)
+        dlg._select_data(dlg.link, 'serial')
+        self.assertFalse(dlg.civ_addr.isHidden())
+        self.assertEqual(dlg.ptt.count(), 4)
+
+    def test_icom_external_ptt_model_keeps_only_external(self):
+        dlg = self.dialog('IC-706')
+        dlg._select_data(dlg.link, 'rigctld')
+        self.assertEqual(dlg.ptt.count(), 1)
+        validate_radio(dlg._radio_values())
+
+    def test_rigctld_fields_toggle_and_save(self):
+        dlg = self.dialog('FT-991 / FT-991A')
+        dlg._select_data(dlg.link, 'rigctld')
+        self.assertTrue(dlg.form_radio.isRowVisible(dlg.rc_host) and dlg.form_radio.isRowVisible(dlg.rc_port))
+        self.assertFalse(dlg.form_radio.isRowVisible(dlg.com)); self.assertTrue(dlg.baud.isHidden())
+        dlg.rc_host.setText('192.168.1.20'); dlg.rc_port.setValue(4540)
+        values = dlg._radio_values()
+        self.assertEqual((values['link'], values['rigctld_host'], values['rigctld_port']), ('rigctld', '192.168.1.20', 4540))
+        dlg._save()
+        saved = self.store.data['radio']
+        self.assertEqual((saved['link'], saved['rigctld_host'], saved['rigctld_port']), ('rigctld', '192.168.1.20', 4540))
+        again = SettingsDialog(self.store)
+        self.assertEqual((again.link.currentData(), again.rc_host.text(), again.rc_port.value()), ('rigctld', '192.168.1.20', 4540))
+
+    def test_icom_serial_values_unchanged(self):
+        dlg = self.dialog('IC-705')
+        for key in ('link', 'rigctld_host', 'rigctld_port'):
+            self.assertNotIn(key, dlg._radio_values())
+
+
+if __name__ == '__main__':
+    unittest.main()
