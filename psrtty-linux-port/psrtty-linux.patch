+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from psrtty import paths
+from psrtty.hamlib_radio import model_supported
+
+
+class FakeLib:
+    def __init__(self, models):
+        self.models = models
+        self.rig_load_all_backends = mock.Mock()
+        self.rig_get_caps = lambda model: 1 if model in self.models else None
+
+
+class DataRootTests(unittest.TestCase):
+    def test_env_override(self):
+        with tempfile.TemporaryDirectory() as td, mock.patch.dict(os.environ, {'PSRTTY_HOME': td}):
+            self.assertEqual(paths.data_root(), Path(td).resolve())
+            root = paths.ensure_runtime_dirs()
+            self.assertEqual(root['config'], Path(td).resolve() / 'config')
+            self.assertTrue(root['logdata'].is_dir())
+
+    def test_readonly_install_uses_xdg(self):
+        with tempfile.TemporaryDirectory() as td, \
+                mock.patch.dict(os.environ, {'XDG_DATA_HOME': td}), \
+                mock.patch.object(paths.sys, 'platform', 'linux'), \
+                mock.patch.object(paths.os, 'access', return_value=False):
+            os.environ.pop('PSRTTY_HOME', None)
+            self.assertEqual(paths.data_root(), Path(td) / 'psrtty')
+
+    def test_writable_install_keeps_legacy_layout(self):
+        os.environ.pop('PSRTTY_HOME', None)
+        with mock.patch.object(paths.os, 'access', return_value=True):
+            self.assertEqual(paths.data_root(), paths.app_root())
+
+
+class HamlibGuardTests(unittest.TestCase):
+    def test_unknown_model_is_refused_not_initialised(self):
+        self.assertFalse(model_supported(FakeLib({1035}), 1051))
+
+    def test_known_model_passes(self):
+        self.assertTrue(model_supported(FakeLib({1051}), 1051))
+
+    def test_library_without_probe_symbols_does_not_block(self):
+        self.assertTrue(model_supported(object(), 1051))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff -ruN -x var -x config -x logdata -x lib a/tests/test_rigctld_link.py b/tests/test_rigctld_link.py
